{
  "name": "bor-zh",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "astro": "astro",
    "test:build": "astro build && vitest run --config vitest.itest.config.ts && node scripts/a11y.mjs && node scripts/check-budget.mjs",
    "test:all": "npm run test && npm run test:build && npm run a11y:mobile && npm run a11y:wide && npm run a11y:picker",
    "a11y": "astro build && node scripts/a11y.mjs",
    "budget": "node scripts/check-budget.mjs",
    "a11y:mobile": "astro build && node scripts/a11y.mjs --mobile",
    "a11y:wide": "astro build && node scripts/a11y.mjs --wide",
    "a11y:picker": "node scripts/a11y-picker.mjs"
  },
  "dependencies": {
    "@fontsource-variable/material-symbols-outlined": "5.3.1",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/noto-mono": "5.3.0",
    "@fontsource/spectral": "^5.3.0",
    "@sveltia/cms": "0.213.0",
    "astro": "^7.3.2"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.3",
    "ajv": "^8.20.0",
    "axe-core": "4.13.0",
    "chromedriver": "153.0.0",
    "esbuild": "0.28.2",
    "selenium-webdriver": "4.44.0",
    "sharp": "0.35.4",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
