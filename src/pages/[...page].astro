---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContentImage from '../components/ContentImage.astro';
import { normalizeHeadingLevels } from '../lib/markdown-headings';
import { resolveContentAssetLinks, stripEmptyAnchors } from '../lib/markdown-links';
import { RESERVED_PATHS } from '../lib/routes';

/*
 * ONE DYNAMIC ROUTE FOR THE PROSE PAGES, not one near-identical file each.
 * They differ only in their content, and a copy of this page per route would
 * be a place per route to fix a heading level, a measure or a link treatment.
 *
 * `getStaticPaths` reads the collection and builds `/${path}/` for each, minus
 * the RESERVED_PATHS - `/contact` and `/doneaza` are built by dedicated files
 * that carry generated blocks this route has no business knowing about. The
 * list is imported rather than copied so the two sides cannot disagree; a page
 * built here and there at once is a route collision, and one skipped by both
 * is a page in the CMS with no page on the site. `routes.test.ts` pins both
 * directions.
 *
 * The path is `pageSchema`'s `path` field - `parohia/istoric`, not the file
 * name `istoric.md` - which is why the route is the single place the two are
 * tied together. The schema already rejects a leading or trailing slash, so
 * the `//istoric//` a stored slash would produce cannot reach here.
 */
export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages
    .filter((entry) => !RESERVED_PATHS.has(entry.data.path))
    .map((entry) => ({ params: { page: entry.data.path }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { title, description } = entry.data;

/*
 * Three transforms on the migrated body, all before `render` and all for
 * defects the migration can reintroduce:
 *
 * 1. Heading levels are shifted so the shallowest is an `<h2>` under the
 *    page's `<h1>`, exactly as `noutati/[slug].astro` does and for the same
 *    measured reason: the migrated WordPress bodies can open at `###`/`####`,
 *    which axe reports as `heading-order`. The nine pages happen to start at
 *    `##` today, so this is a no-op for them - and it stays because the rule
 *    belongs to the pipeline that renders a body, not to today's files.
 * 2. Empty anchors are removed. `cursuri-de-pictura` carries ten
 *    `[](https://www.bor-zh.ch/wp-content/uploads/…jpg)` links from its
 *    WordPress gallery - invisible to a sighted visitor, unnamed for everyone
 *    else, and a red `link-name` axe pass. `markdown-links.ts` states the rule
 *    and why it is conservative.
 * 3. Content-asset anchors are resolved. The migration turned that same
 *    gallery's eleven full-size images into `[name](../../assets/content/…)`
 *    links; Astro rewrites markdown IMAGES, not link nodes, so without this
 *    the built page emitted `href="../../assets/content/…"` - measured on the
 *    d73b49e build, resolving to `/assets/content/…` where `dist/assets/`
 *    does not exist, and three of the eleven originals were in the build only
 *    as `.webp` derivatives, unreachable from those hrefs. The helper imports
 *    every content asset with `?url`, so the originals are emitted and each
 *    href names one; a named anchor it cannot resolve stops the build rather
 *    than shipping a 404. It runs AFTER the strip, so an empty anchor to a
 *    missing file is still removed rather than made fatal.
 *
 * A COPY, not a mutation: `entry` is the object `getStaticPaths` handed in,
 * and `render` reads `entry.rendered` (the loader renders collection entries
 * eagerly), so the transformed body is passed in its place and the original is
 * left alone. Image references survive because none of the transforms touches
 * `<img>`, and `render` does its asset rewriting after this.
 */
const rendered = entry.rendered
  ? {
      ...entry.rendered,
      html: resolveContentAssetLinks(
        stripEmptyAnchors(normalizeHeadingLevels(entry.rendered.html)),
      ),
    }
  : entry.rendered;
const { Content } = await render({ ...entry, rendered });
---

<Base title={title} description={description}>
  <div class="container prose reading-column">
    <h1>{title}</h1>
    {entry.data.image && (
      <div class="page-image">
        <ContentImage
          image={entry.data.image}
          alt={title}
          sizes="(max-width: 34rem) 90vw, 68ch"
          loading="eager"
        />
      </div>
    )}
    <Content />
  </div>
</Base>

<style>
  /*
   * The prose treatment mirrors `noutati/[slug].astro`, which carries the
   * measurements behind each rule: headings step down the display face, and the
   * blockquote is a rule rather than a colour. The measure and the centering
   * are NOT here - they live on `.container.reading-column` in `global.css`,
   * which this route's wrapper carries, so the text box is exactly `--masura`
   * and shares one axis with every generated block.
   *
   * NO `color` IS DECLARED FOR `a`, deliberately. global.css's `a`/`a:hover`
   * pair already colours the body links, and a scoped colour here would ship
   * at (0,3,1) and silently defeat the (0,1,1) hover - the trap
   * `SiteHeader.astro` documents. Nothing here declares `outline` either, so
   * the global `:focus-visible` ring reaches these links too.
   */
  .prose h1 { margin-top: 2rem; margin-bottom: 1.25rem; }
  .page-image { margin: 0 0 1.75rem; border: 1px solid var(--rule); }
  .prose :global(p) { margin: 0 0 1.25rem; }
  .prose :global(h2) { font-size: 1.5rem; margin-block: 2rem 0.75rem; }
  .prose :global(h3) { font-size: 1.25rem; margin-block: 1.75rem 0.5rem; }
  .prose :global(h4) { font-size: 1.0625rem; margin-block: 1.5rem 0.5rem; }
  .prose :global(ul),
  .prose :global(ol) { margin: 0 0 1.25rem; padding-left: 1.5rem; }
  .prose :global(li) { margin-bottom: 0.35rem; }
  .prose :global(blockquote) {
    margin: 1.5rem 0;
    padding-left: 1rem;
    border-left: 3px solid var(--rule);
    color: var(--muted);
  }
  .prose :global(img) { margin: 1.5rem 0; }
  /*
   * LONG TOKENS WRAP INSTEAD OF OVERFLOWING THEIR PARAGRAPH, and the rule is
   * here because a browser is what found it. `cursuri-de-pictura`'s gallery is
   * eleven links whose text is a file name, and the longest,
   * `299423305_1614475615639_144441808512976432_n`, has no break opportunity at
   * all. Measured on the built page at 390px: the link is 389px against the
   * 358px paragraph, so it overflowed its block ancestor. axe's color-contrast
   * rule cannot decide the background of text its block ancestor does not fully
   * encompass (`fullyEncompasses` in axe-core), so it returned an `incomplete`
   * for six of the eleven - and an incomplete is a red browser pass here. With
   * `break-word` the widest link measures 358px and the phone pass is green.
   * `break-word`, not `anywhere`, to match the rule already used for `pre`
   * above.
   */
  .prose :global(a) { overflow-wrap: break-word; }
  /*
   * No page carries a code block today, and this is here for the same reason
   * the heading normalisation is: the next migrated body can. `pre-wrap` is
   * what keeps a long line from scrolling a phone sideways - measured on the
   * one article that has such a block, at `innerWidth` 390: 2,091px of
   * document width with `white-space: pre`, 390px with `pre-wrap`.
   */
  .prose :global(pre) {
    margin: 1.5rem 0;
    padding: 0.875rem 1rem;
    background: var(--raised);
    border: 1px solid var(--rule);
    white-space: pre-wrap;
    overflow-wrap: break-word;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
</style>
