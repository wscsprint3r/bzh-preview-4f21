---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BandaSaptamanii from '../components/BandaSaptamanii.astro';
import SelectorSaptamana from '../components/SelectorSaptamana.astro';
import { formatIntervalSaptamana, numeLuna, numeZi, ziuaDinLuna } from '../lib/date-ro';
import {
  etichetaSlujba,
  listaRomaneasca,
  saptamaniViitoare,
  slujbeLaAceeasiOra,
  urmatoareaSlujba,
  type ZiPentruCard,
} from '../lib/schedule';
import { acumLaZurich } from '../lib/week';

const intrari = await getCollection('slujbe');
/*
 * `data` is two different things on this line, exactly as on `/program/`.
 * `e.data` is Astro's parsed frontmatter — every field `ziSchema` validated,
 * which is every field of a day EXCEPT its date; the date is the filename, i.e.
 * `e.id`. Spread first, then set `data` (Romanian for date) from the id.
 * Either order reversed leaves `zi.data` undefined and every day throws
 * `Dată invalidă: undefined` out of `partiData`.
 */
const zile = intrari.map((e) => ({ ...e.data, data: e.id }));

/*
 * The date and the time from ONE reading of the clock. Two calls would be two
 * `new Date()`s, and a build that straddled midnight would stamp the 20th with
 * `00:00` on the 21st onto the card - rarer than the client's window, and the
 * same fifteen-hour-past Liturgy when it happens.
 */
const { azi, ora } = acumLaZurich();
/*
 * Three weeks, not the whole schedule: spec §13 budgets this page at 30 KB of
 * HTML and `/program/` carries the full list. `saptamaniViitoare` counts weeks
 * WITH ENTRIES, not calendar weeks, so these three can span six calendar weeks
 * — which is why no heading below states a date range for the set. Each week
 * prints its own interval, which is the only range that is true.
 */
const saptamani = saptamaniViitoare(zile, azi, 3);
const urmatoarea = urmatoareaSlujba(zile, azi, ora);

/*
 * The card names every service that starts at the same minute, not only the one
 * `urmatoareaSlujba` returned — the rule and its reasoning live in
 * `slujbeLaAceeasiOra`, which is tested against a fixture with a `17:00`
 * Spovedanie beside a `17:00` Vecernie.
 *
 * The day is looked up once and used twice, for its services here and for its
 * `locatie` below. The `?? [urmatoarea]` is unreachable — the date is the
 * collection's primary key, so the day the helper read from is always found —
 * and exists so this list is never empty while the card is rendered.
 */
const ziuaUrmatoare = urmatoarea ? zile.find((z) => z.data === urmatoarea.data) : undefined;
const deopotriva = urmatoarea
  ? slujbeLaAceeasiOra(ziuaUrmatoare?.slujbe ?? [urmatoarea], urmatoarea.ora)
  : [];
const nume = deopotriva.map(etichetaSlujba);
/*
 * Romanian list: "A", "A și B", "A, B și C". This was an expression on this
 * line until Task 10; it is a function in `schedule.ts` because the week
 * picker's script composes the same sentence in the browser once the clock has
 * moved past this service, and one sentence rule written twice is exactly how
 * two renderings of the same evening come to disagree.
 */
const impreuna = listaRomaneasca(nume);

/*
 * The card names the place only when the day has one, so on an ordinary day it
 * stays as short as it is meant to be and the exception is what announces
 * itself.
 *
 * It has to name it at all for the same reason the band does, only more so:
 * this card is the first thing on the page, it is what someone checking "when
 * is the next service" reads, and `ics.ts` writes this value into the feed's
 * LOCATION. Without it the card is confidently wrong on exactly the day when
 * being wrong costs a wasted journey — the reader of the page drives to Zürich
 * while the subscriber to the calendar drives to Winterthur. Not in the brief;
 * the brief asked only that the band carry it.
 */
const undeUrmatoarea = ziuaUrmatoare?.locatie ?? '';

/*
 * One composition of the day's heading, used by the card below and carried in
 * the island for the script that rewrites it. Written once so the two can never
 * be formatted differently.
 */
const titluZi = (d: string) => `${numeZi(d)}, ${ziuaDinLuna(d)} ${numeLuna(d)}`;

/*
 * The schedule the card can still be recomputed from, embedded for the week
 * picker's script — spec §7, the half of it the week band does not cover.
 *
 * Everything from today onward and nothing else. `urmatoareaSlujba` never looks
 * behind `azi`, so this projection yields exactly the answer the full list
 * would, for any clock at or after this build's — which is the only direction a
 * clock moves. It is NOT the three weeks rendered below: were every day in those
 * weeks cancelled, the card's answer would lie outside them.
 *
 * A projection rather than the days themselves: a `praznic` or a `note` would be
 * bytes on every homepage for fields the card never renders, and `ZiPentruCard`
 * is what stops the projection quietly losing `anulat` — which is the field that
 * keeps a cancelled Liturgy from being announced as the next service.
 */
const program: ZiPentruCard[] = zile
  .filter((z) => z.data >= azi)
  .map((z) => ({
    data: z.data,
    anulat: z.anulat,
    locatie: z.locatie,
    // Rendered here, not in the browser: `etichetaSlujba` owns the `Altceva`
    // escape hatch, and the card must never be the one place that word reaches
    // a page. Shipping the rule instead of its output would put a second copy
    // of it behind the one guard that cannot see it.
    slujbe: z.slujbe.map((s) => ({ ora: s.ora, nume: etichetaSlujba(s) })),
    titlu: titluZi(z.data),
  }));

/*
 * `<` escaped, so that a `locatie` or a `detaliu` a volunteer typed can never
 * close this script element early. Built from `String.fromCharCode(92)` rather
 * than written as an escape sequence: a backslash followed by u and four hex
 * digits is decoded into the character it names on the way to disk in this repo
 * (see CLAUDE.md), so the literal form would land here as a bare `<` and do the
 * exact opposite of its job.
 */
const insula = JSON.stringify(program).replaceAll('<', `${String.fromCharCode(92)}u003C`);
---

<Base titlu="Bine ați venit">
  {/*
    The hero takes its ground from an ancestor, so the static hex guard cannot
    see it and only axe can. THE GOLD ROLES INVERT on this ground: `--gold-text`
    is 4.67:1 on the page and 2.26:1 here, `--gold-lt` is 2.18:1 on the page and
    4.82:1 here. Every colour below is from ROLURI_TEXT_PE_OXBLOOD in
    `lib/tokens.ts` — parchment 10.54:1, gold-lt 4.82:1, rule 8.12:1. Do not
    copy `a { color: var(--gold-text) }` from global.css into this section, and
    do not put a link in it without choosing a colour from that set.
  */}
  <section class="hero">
    <div class="container hero-in">
      <p class="hero-kick">Wehntalerstrasse 451 · 8046 Zürich</p>
      <h1>Bine ați venit în casa Domnului</h1>
      <p class="hero-verset">„Căutați mai întâi împărăția lui Dumnezeu și dreptatea Lui” — Matei 6:33</p>
    </div>
  </section>

  <div class="container">
    {urmatoarea && (
      <>
        <p class="urm" data-urm>
          <span class="eyebrow">Următoarea slujbă</span>
          <b data-urm-zi>{titluZi(urmatoarea.data)}</b>
          {/*
            Three spans where one used to do, because the week picker's script
            rewrites this card in the browser. Every Romanian word and every
            separator on it — the em dash here, the "la" below — exists exactly
            once, in this file, where a reader can see it; the script only writes
            values into the spans that hold them. A script composing the same
            line itself would be a second copy of this sentence, and the two
            would drift the first time anyone edited one of them.
          */}
          <span class="urm-slujbe"><span data-urm-ora>{urmatoarea.ora}</span> — <span data-urm-nume>{impreuna}</span></span>
          {/*
            Always rendered and `hidden` when the day has no location, rather
            than rendered conditionally: the script then has a span to fill
            instead of an element to build, and with JavaScript off `hidden`
            leaves exactly what the conditional used to produce.
          */}
          <span class="urm-loc" data-urm-loc hidden={!undeUrmatoarea}>la <span data-urm-unde>{undeUrmatoarea}</span></span>
        </p>
        {/* `is:inline` is the point, not a concession: this is data, not a
            module for Astro to bundle. Stated explicitly so the intent is a
            decision in the source rather than a hint in the build log. */}
        <script is:inline type="application/json" data-program set:html={insula}></script>
      </>
    )}

    {/*
      Not "Programul săptămânii", and not any heading that counts weeks.
      `saptamaniViitoare` counts weeks WITH ENTRIES, so this section renders
      between zero and three of them and they can span more calendar weeks than
      that. From Task 10 the count also depends on whether JavaScript ran: one
      week revealed with it, all three without. A heading naming a number or a
      span would be false in at least one of those states and nothing would
      fail. This one cannot become false. The interval under each band is the
      only date range on the page, and it is true because each week states its
      own.
    */}
    <h2 class="titlu-sect">Programul slujbelor</h2>

    {saptamani.length === 0 ? (
      <p class="gol">Programul următoarei perioade nu a fost încă publicat. <a href="/program/">Vezi programul complet</a>.</p>
    ) : (
      <>
        <SelectorSaptamana />
        {saptamani.map((s) => {
          /*
           * One call, three uses. `data-interval` is what the week picker puts
           * in its bar, so the control and the heading it selects are the same
           * string by construction - the script used to recover it by stripping
           * "Săptămâna " off the aria-label, which broke silently if either the
           * wording or the space ever changed, and put a Romanian word in the
           * bundle to do it.
           */
          const interval = formatIntervalSaptamana(s.luni, s.duminica);
          return (
            <section data-saptamana={s.cheie} data-interval={interval} aria-label={`Săptămâna ${interval}`}>
              <p class="interval">{interval}</p>
              <BandaSaptamanii saptamana={s} />
            </section>
          );
        })}
      </>
    )}

    <p class="tot"><a href="/program/">Programul complet →</a></p>
  </div>
</Base>

<style>
  .hero { background: var(--oxblood); color: var(--parchment); }
  .hero-in { padding-block: clamp(2.5rem, 7vw, 4.5rem); }
  .hero-kick { font-size: 0.625rem; letter-spacing: 0.28em; text-transform: uppercase; color: var(--gold-lt); margin: 0 0 0.75rem; }
  /* Scoped, so this ships at (0,2,1) and defeats global.css's `h1` at (0,0,1).
     That is the intended direction here — the heading must leave the oxblood
     ground it would otherwise inherit from. It is the same mechanism that
     silently costs a scoped link its hover, so it is named rather than left to
     be rediscovered: nothing in this block declares a colour for an `a`, and
     there is no link in the hero to lose one. */
  .hero h1 { color: var(--parchment); font-size: clamp(1.875rem, 5vw, 2.75rem); font-weight: 500; }
  /* A synthesised slant, on purpose. Spectral ships no italic face here and
     adding one costs two requests, which would put this page over spec §13's
     limit of 12 once Task 10's script lands. See Task 7's request arithmetic. */
  .hero-verset { font-style: italic; color: var(--rule); max-width: var(--masura); margin: 0.75rem 0 0; }
  /* The user-agent/author-origin trap `SelectorSaptamana` documents, in its
     second place: an author `display: flex` beats the UA stylesheet's
     `[hidden] { display: none }` outright — author origin wins over UA origin
     whatever the specificity — so without this rule the script could not hide a
     card whose service has already happened. It would set the attribute and
     nothing at all would change on screen. Measured in a browser, both ways
     round; see the report. */
  .urm[hidden] { display: none; }
  .urm { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.35rem 1rem; border: 1px solid var(--gold-lt); background: var(--raised); padding: 1rem 1.25rem; margin-block: 1.75rem 0; }
  .urm b { font-family: var(--display); font-size: 1.25rem; color: var(--oxblood); }
  /* By class, not `> span:last-child`. The location span below is shown only
     on the days that have a `locatie`, so a positional selector would mean "the
     service times" on most days and "the address" on those, and would hand the
     times the colour of whichever element happened to come last. Since Task 10
     that span is always PRESENT and merely `hidden`, which makes a positional
     selector wrong every day rather than most days. */
  .urm-slujbe { color: var(--muted); }
  /* Oxblood, not muted: this line only appears when the service has moved, and
     it is the one fact on the card that a regular cannot supply from memory.
     11.17:1 on `--raised`. */
  .urm-loc { color: var(--oxblood); }
  .titlu-sect { font-size: 1.375rem; margin-block: 2rem 0.25rem; }
  .interval { font-family: var(--display); font-size: 1.0625rem; color: var(--faint); margin: 0 0 0.75rem; }
  .gol { color: var(--muted); font-style: italic; }
  .tot { margin-block: 1.75rem 0; }
</style>
