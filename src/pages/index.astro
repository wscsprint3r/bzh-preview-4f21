---
import { Image } from 'astro:assets';
import heroImage from '../assets/content/2025/12/7-hero.jpg';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArticleList from '../components/ArticleList.astro';
import WeekBand from '../components/WeekBand.astro';
import WeekPicker from '../components/WeekPicker.astro';
import { publishedArticles } from '../lib/articles';
import { formatWeekRange } from '../lib/date-ro';
import { upcomingWeeks } from '../lib/schedule';
import { nowInZurich } from '../lib/week';

const entries = await getCollection('services');
/*
 * `data` and `date` are two different things on this line, exactly as on
 * `/program/`, where the full reasoning lives. `e.data` is Astro's own name for
 * the parsed frontmatter — every field `daySchema` validated, which is every
 * field of a day EXCEPT its date; the date is the filename, i.e. `e.id`.
 *
 * DROPPING the override fails the build with `Invalid date: undefined` out of
 * `dateParts`. REVERSING the order does nothing at all — `daySchema` declares no
 * `date` key, so both orders build byte-identical output, checked both ways.
 * This comment used to claim the reverse crashed; it does not. `date` goes last
 * to keep the validated filename authoritative if the schema ever gains that
 * field, which is a reason that survives being tested.
 */
const days = entries.map((e) => ({ ...e.data, date: e.id }));

/*
 * Only the date is needed here. `nowInZurich` still returns the pair from ONE
 * reading of the clock and must keep doing so: the week picker's script reads
 * the same function in the browser, and taking the pair apart is how a build or
 * a browser straddling midnight comes to answer the 20th and `00:00` on the
 * 21st in the same breath.
 */
const { today } = nowInZurich();
/*
 * Three weeks, not the whole schedule: spec §13 budgets this page at 30 KB of
 * HTML and `/program/` carries the full list. `upcomingWeeks` counts weeks
 * WITH ENTRIES, not calendar weeks, so these three can span six calendar weeks
 * — which is why no heading below states a date range for the set. Each week
 * prints its own interval, which is the only range that is true.
 */
const weeks = upcomingWeeks(days, today, 3);

/*
 * The news section, through the one filter `/noutati` and `/rss.xml` also use.
 * `ArticleList`'s `limit` slices AFTER `publishedArticles` has sorted, so "the
 * three newest" is the order the index page shows rather than whatever order
 * `getCollection` returned. The section renders only when something is
 * published: an empty heading with a link to an empty list is a worse answer
 * than no section at all.
 */
const articles = publishedArticles(await getCollection('articles'));
---

<Base title="Bine ați venit">
  {/*
    The hero takes its ground from an ancestor, so the static hex guard cannot
    see it and only axe can. THE GOLD ROLES INVERT on this ground: `--gold-text`
    is 4.67:1 on the page and 2.26:1 here, `--gold-lt` is 2.18:1 on the page and
    4.82:1 here. Every colour below is from TEXT_ROLES_ON_OXBLOOD in
    `lib/tokens.ts` — parchment 10.54:1, gold-lt 4.82:1, rule 8.12:1. Do not
    copy `a { color: var(--gold-text) }` from global.css into this section, and
    do not put a link in it without choosing a colour from that set.
  */}
  <section class="hero">
    {/*
      ONE SOURCE, TWO CROPS, AND THE REQUEST COUNT IS WHY. The approved mockup
      asked for a <picture> with a 16:6 source and a 3:2 source; measured
      against `check-budget.mjs`, every <source> is a possible fetch and the
      homepage has exactly one request left (11 of 12 today). Two sources plus
      the fallback measure 14/12 — a red build with no room to raise the limit.
      A single photograph cropped by `object-fit`/`object-position` gives the
      same two framings for one request: the wide hero box shows the band, the
      phone's taller box shows nearly the whole frame. The focal points below
      were re-measured in a browser for this photograph on 2026-09-21 — 50% 8%
      on the desktop band and 50% 62% in the 34rem phone box keep all four
      clergy's faces, the cross and the altar table inside at 390, 756 and 1280
      CSS px wide; adjust them by eye against `npm run dev`, never by a crop
      algorithm.

      THE SOURCE IS A DERIVATIVE, `src/assets/content/2025/12/7-hero.jpg`,
      1600×800, NOT THE ALBUM FILE. The photograph is one of the four in the
      album `sfantul-nicolae-2025`, and cropping that file in place would
      re-frame the gallery too. This one was cut from
      `src/assets/content/2025/12/7.jpg` once, with `sharp(src).resize({ width:
      1600 }).extract({ left: 0, top: 280, width: 1600, height: 800 }).jpeg({
      quality: 90 })` — 2:1, keeping the rows the phone crop shows and the band
      the desk crop shows. The top came from a five-window contact sheet
      (160/200/240/280/320), compared by eye: top 280 keeps all four clergy,
      the cross and the altar table whole with the ceiling line above them, and
      the windows above it add only ceiling. `src/lib/hero-image.itest.ts`
      holds those bytes to a ceiling: measured through Astro at its default
      quality, this crop's 1200w candidate is 137,744 B, its 800w 70,706 B and
      its 480w 28,834 B, while the same source uncropped measures 207,858 B at
      1200w — over the 180,000 B ceiling, which is why the page gets a crop
      rather than the album file. Re-cut the derivative rather than adding the
      1600w candidate back.
    */}
    <Image
      class="hero-img"
      src={heroImage}
      alt=""
      widths={[480, 800, 1200]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="container hero-in">
      <h1>Bine ați venit</h1>
      <p class="hero-verse">„Căutați mai întâi împărăția lui Dumnezeu și dreptatea Lui” — Matei 6:33</p>
    </div>
  </section>

  <div class="container">
    {/*
      Not "Programul săptămânii", and not any heading that counts weeks.
      `upcomingWeeks` counts weeks WITH ENTRIES, so this section renders
      between zero and three of them and they can span more calendar weeks than
      that. From Task 10 the count also depends on whether JavaScript ran: one
      week revealed with it, all three without. A heading naming a number or a
      span would be false in at least one of those states and nothing would
      fail. This one cannot become false. The interval under each band is the
      only date range on the page, and it is true because each week states its
      own.
    */}
    <h2 class="section-title">Programul slujbelor</h2>

    {/*
      THE PICKER IS MOUNTED WHETHER OR NOT THERE IS A WEEK TO PICK, and that is
      a build property, not a layout one. Its script is the homepage's only
      inline `<script>`, and `scripts/csp-hash.mjs` names it in
      `EXPECTED_INLINE` unconditionally: while this component sat inside the
      `weeks.length > 0` branch, the first day with no upcoming week — the
      ordinary state between publications, measured 2026-09-21, the day after
      the last published Sunday — produced a homepage with no inline script and
      `csp-hash` stopped the build. A volunteer saving an article would have
      met a red run with nothing wrong with their article.

      Nothing shows for it: the bar ships `hidden`, and the script reveals it
      only when there is more than one week section to select (its own comment
      explains why one week is not selectable), so in the empty state the page
      is the message below and a bar nobody sees. The script still runs, and
      still costs no request.
    */}
    <WeekPicker />

    {weeks.length === 0 ? (
      <p class="empty">Programul următoarei perioade nu a fost încă publicat. <a href="/program/">Vezi programul complet</a>.</p>
    ) : (
      <>
        {weeks.map((s) => {
          /*
           * One call, three uses. `data-interval` is what the week picker puts
           * in its bar, so the control and the heading it selects are the same
           * string by construction - the script used to recover it by stripping
           * "Săptămâna " off the aria-label, which broke silently if either the
           * wording or the space ever changed, and put a Romanian word in the
           * bundle to do it.
           */
          const interval = formatWeekRange(s.monday, s.sunday);
          return (
            <section data-week={s.key} data-interval={interval} aria-label={`Săptămâna ${interval}`}>
              <p class="interval">{interval}</p>
              <WeekBand week={s} />
            </section>
          );
        })}
      </>
    )}

    <p class="all"><a href="/program/">Programul complet →</a></p>
  </div>

  {/*
    The third and last part of the homepage per spec §5: hero, week band, news.
    `headingLevel={3}` because this section owns the page's second `<h2>` — a
    card that rendered its default level would put an `<h2>` under a `<h2>` and
    skip the level axe's heading-order rule expects.

    No empty state here on purpose: when nothing is published the whole section
    is absent, because a heading over an empty list and a link to an empty page
    tell a visitor less than nothing.
  */}
  {articles.length > 0 && (
    <div class="container">
      <h2 class="section-title">Noutăți</h2>
      <ArticleList articles={articles} limit={3} headingLevel={3} />
      <p class="all"><a href="/noutati/">Toate noutățile →</a></p>
    </div>
  )}
</Base>

<style>
  .hero { position: relative; background: var(--oxblood); color: var(--parchment); overflow: hidden; }
  /*
   * THE SCRIM IS A FLAT WASH, not a gradient: the verse's second line falls on
   * the photograph's lightest region, and a gradient's thin end is where AA
   * fails. `color-mix` rather than `rgba(107, 31, 38, …)`: the literal would
   * restate `--oxblood`'s channels, and a token change would desync the scrim
   * with no test to notice. The percentage is the one measured by the pixel
   * guard in a11y.mjs (Task 7) — do not lower it without re-measuring, and do
   * not raise it to make the picture "read better"; the guard's number is the
   * requirement. MEASURED when Task 7 landed, on the Phase 4 crop this page
   * used then: 78% gave the verse 4.42:1 against its 4.5:1 minimum, on the
   * pure-white highlight that crop put under it; 82% measured 4.97:1 there.
   * RE-MEASURED 2026-09-21 against the cross-procession crop: 82% gives the
   * verse 5.01:1 over the default pass's 741x190 px box, 5.03:1 over the
   * phone pass's 375x181 px box (390 CSS px) and 5.01:1 over the wide pass's
   * 1085x235 px box. The guard prints the worst ratio it measured on every
   * run, so these sentences are checkable rather than authoritative.
   */
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    /* THE FIRST LINE IS FOR BROWSERS THAT DO NOT KNOW `color-mix`: they drop
       the second declaration and would otherwise paint NO scrim, leaving
       parchment text directly on the photograph — the failing control Task 7
       measured on the replaced Phase 4 crop at 3.48:1 and 2.66:1. Opaque
       oxblood is the band the hero shipped before the scrim existed, and it
       already passed AA. No pass in this repository can see the difference:
       Chrome supports `color-mix`, so both declarations parse and the second
       wins. */
    background: var(--oxblood);
    background: color-mix(in srgb, var(--oxblood) 82%, transparent);
  }
  .hero-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 8%; }
  /* The phone box is 2.10:1 against the crop's 2:1, so nearly the whole frame
     is visible and object-position moves the window by ~23 of the 800 rows:
     62% trims the empty ceiling rows first, leaving every face, the cross and
     the altar table in frame. Measured 2026-09-21 at 390 CSS px through
     `Emulation.setDeviceMetricsOverride` — Chrome clamps a plain window under
     about 500px, so a 390px request by any other route is 500px wide and
     measures a different box. */
  @media (max-width: 34rem) { .hero-img { object-position: 50% 62%; } }
  .hero-in { position: relative; z-index: 1; padding-block: clamp(2.5rem, 7vw, 4.5rem); }
  /* A 2px gold-lt hairline echoing the feast-row rule. Ornament, never text. */
  .hero { border-bottom: 2px solid var(--gold-lt); }
  /* Scoped, so this ships at (0,2,1) and defeats global.css's `h1` at (0,0,1).
     That is the intended direction here — the heading must leave the oxblood
     ground it would otherwise inherit from. It is the same mechanism that
     silently costs a scoped link its hover, so it is named rather than left to
     be rediscovered: nothing in this block declares a colour for an `a`, and
     there is no link in the hero to lose one. */
  .hero h1 { color: var(--parchment); font-size: clamp(1.875rem, 5vw, 2.75rem); font-weight: 500; }
  /* A synthesised slant, on purpose. Spectral ships no italic face here and
     adding one costs two requests, which would put this page over spec §13's
     limit of 12 once Task 10's script lands. See Task 7's request arithmetic. */
  .hero-verse { font-style: italic; color: var(--rule); max-width: var(--masura); margin: 0.75rem 0 0; }
  .section-title { font-size: 1.375rem; margin-block: 2rem 0.25rem; }
  .interval { font-family: var(--display); font-size: 1.0625rem; color: var(--faint); margin: 0 0 0.75rem; }
  .empty { color: var(--muted); font-style: italic; }
  .all { margin-block: 1.75rem 0; }
</style>
