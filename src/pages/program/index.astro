---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DayRow from '../../components/DayRow.astro';
import { formatWeekRange } from '../../lib/date-ro';
import { groupIntoWeeks } from '../../lib/schedule';
import { todayInZurich, weekKey, weekStart } from '../../lib/week';

const entries = await getCollection('services');
/*
 * `data` and `date` are two different things on this line. `e.data` is Astro's
 * own name for the parsed frontmatter — everything `daySchema` validated, which is every field of a day
 * EXCEPT its date, because Zod is handed a file's contents and never its name.
 * The date is the filename, i.e. `e.id`, validated by `idFromFilename`.
 *
 * DROPPING the override is the mistake that bites: `day.date` is then undefined
 * and the build fails with `Dată invalidă: undefined` out of `dateParts`.
 * Verified by doing it.
 *
 * REVERSING the order is not that mistake, and this comment used to say it was.
 * `daySchema` is strict and declares no `date` key, so the spread has nothing to
 * overwrite and `{ date: e.id, ...e.date }` builds byte-identical output —
 * checked both ways round. Writing `date` last still says the right thing,
 * which is which source wins if the schema ever gains that field: the filename,
 * the one that was validated as a date, over a YAML field that could contradict
 * it. Keep the line; the reason is that, not a crash that does not happen.
 */
const days = entries.map((e) => ({ ...e.data, date: e.id }));

// One clock read; the Monday and the week key are both derived from it.
const today = todayInZurich();
const monday = weekStart(today);

/*
 * THIS PAGE SHOWS EVERY WEEK, AND MUST GO ON DOING SO.
 *
 * The homepage is a glance: space is scarce there and one week is the right
 * answer, which is what the week picker is for. This page is the full
 * schedule, where browsing ahead IS the point - so hiding weeks would cost a
 * visitor the thing they came for, break Ctrl+F, and leave a screen reader
 * meeting one week of a page that promises the programme. It would also take
 * every hidden week out of `npm run a11y`, which skips hidden elements.
 *
 * So there is no picker here and no script at all. The current week is marked
 * instead, so a visitor lands oriented without anything being taken away.
 */
const todayKey = weekKey(today);
const weeks = groupIntoWeeks(days).filter((s) => s.sunday >= monday);
---

<Base title="Program liturgic" description="Programul slujbelor la Parohia Ortodoxă Română Sfântul Nicolae din Zürich.">
  <div class="container">
    <p class="eyebrow" style="margin-top:2rem">Informații parohiale</p>
    <h1>Program liturgic</h1>

    {weeks.length === 0 ? (
      <p class="gol">Programul următoarei perioade nu a fost încă publicat.</p>
    ) : (
      weeks.map((s) => (
        <section
          data-saptamana={s.key}
          class:list={[s.key === todayKey && 'sapt-curenta']}
          aria-label={`Săptămâna ${formatWeekRange(s.monday, s.sunday)}`}
        >
          <h2 class="sapt">{formatWeekRange(s.monday, s.sunday)}</h2>
          {s.days.map((z) => <DayRow day={z} />)}
        </section>
      ))
    )}

    <p class="abonare"><a href="/program.ics">† Adaugă programul în calendarul telefonului</a></p>
  </div>
</Base>

<style>
  /* Every section carries the same box, so marking one below cannot shift the
     page. No top padding on purpose: the `.sapt` heading's 2rem top margin
     collapses through, so the mark hugs the heading instead of opening with
     2rem of empty band. The negative inline margin keeps the text on the same
     line it sits on in every other section; the container's gutter is
     `clamp(1rem, 4vw, 2.25rem)`, so 1rem can never pull past the viewport. */
  section[data-saptamana] { padding: 0 1rem 1rem; margin-inline: -1rem; }
  /* The week the visitor is in, marked so this page opens oriented while still
     showing everything.

     A RULE, NOT A GROUND. `DayRow` already marks a feast day with
     `background: var(--raised)`; putting a ground on the section would erase
     that distinction inside the one week a visitor is most likely to be
     reading. A 3px bar on the leading edge is a positional signal rather than
     colour alone, and it is a border, so the 4.5:1 text rule does not apply to
     it - the same exemption `.rule` takes in global.css.

     DELIBERATELY WORDLESS. This is computed at BUILD time, and a static
     build's idea of „today” goes stale: between Sunday midnight and the next
     rebuild - at most six hours, per Task 13 - it sits on the week that has
     just ended. A bar briefly on the wrong week is a hint that is briefly
     unhelpful; the words „săptămâna aceasta” would be a statement that is
     briefly false, and this site does not make those. The `<h2>` carries the
     dates, which are true whenever they are read. */
  .sapt-curenta { box-shadow: inset 3px 0 0 var(--gold-lt); }
  .sapt { font-size: 1.375rem; margin-block: 2rem 0.75rem; padding-bottom: 0.5rem; border-bottom: 1px solid var(--rule); }
  .gol { color: var(--muted); font-style: italic; }
  .abonare { margin-block: 2rem; }
  .abonare a { display: inline-block; border: 1px solid var(--gold-lt); color: var(--oxblood); text-decoration: none; font-size: 0.8125rem; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.75rem 1.25rem; }
  /* A component that colours a link owns that link's hover and focus states.
     Astro scopes this block with a `data-astro-cid-…` attribute, which counts
     as an attribute selector, so the rule above ships as
     `.abonare[data-astro-cid-…] a[data-astro-cid-…]` — specificity (0,3,1).
     global.css's `a:hover` is (0,1,1) and therefore loses, silently: no test,
     no axe run and no build notices a link that never changes on hover. Checked
     by reading the selector out of `dist/program/index.html` rather than out of
     the source, since scoping is added at build time. `:hover` here restores
     the global colour at (0,4,1). Focus needs no such rule — global.css sets
     `outline` on `:focus-visible`, which nothing in this block declares, so
     there is nothing to defeat; verified on the built page. */
  .abonare a:hover { color: var(--oxblood-dk); }
</style>
