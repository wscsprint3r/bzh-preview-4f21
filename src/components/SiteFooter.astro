---
import { getCollection } from 'astro:content';
import { pickSettings } from '../lib/settings';

/*
 * The parish's contact details come from the `settings` singleton, so changing
 * a phone number or the address is a CMS edit rather than a developer's. The
 * live site's footer used to show `info@website.com` and a French phone number,
 * both Athos theme demo leftovers, and they are deliberately not carried over.
 *
 * `pickSettings` stops the build when the file is missing or doubled — a footer
 * that renders blank looks like a design choice, and this one is on every page.
 * See its comment for the two diagnostics.
 *
 * THE ADDRESS RENDERS AS ONE LINE. It used to be split across a `<br />` before
 * the street, which was a rendering choice made when the string was a literal
 * here. There is no second address to keep in step, and where an editable
 * string should break is not something this file can decide for every value a
 * volunteer might type.
 *
 * THE PHONE IS PLAIN TEXT, NOT A `tel:` LINK, and that is a decision rather
 * than an omission. The schema promises only that the field is non-empty: it
 * does not constrain the format, and the value it holds today is Swiss national
 * form ("076 512 04 52") while the number the old hardcoded link dialled was
 * international (+41...). A deterministic `tel:` href built from the string
 * cannot know the country code, so it would either dial the wrong number from
 * abroad or need that code hardcoded back into this file — which is the second
 * source of truth this change exists to remove. Text a phone recognises beats a
 * link that claims a format nothing checks.
 */
const settings = pickSettings(await getCollection('settings'));

/*
 * THE FOOTER CARRIES THE FULL SITEMAP, and it is here rather than in the header
 * because the header is the primary navigation rather than the index. The
 * `Pagini` menu is the eleven prose pages, ordered by the parish's own `order`
 * field (the CMS labels it "Ordinea în meniu"); the fixed `Site` list beside it
 * carries the routes that are not `pages` entries. Before this menu the nine
 * Phase 2 prose routes existed and seven had no inbound link anywhere on the
 * site: built, tested and unreachable, the shape `build-output.itest.ts` now
 * fails on.
 */
const pages = (await getCollection('pages')).sort((a, b) => a.data.order - b.data.order);
const siteLinks = [
  { href: '/program/', text: 'Program' },
  { href: '/noutati/', text: 'Noutăți' },
  { href: '/evenimente/', text: 'Evenimente' },
  { href: '/galerie/', text: 'Galerie' },
  { href: '/pastorale/', text: 'Pastorale' },
];
const path = Astro.url.pathname;
---

<footer class="sf">
  <div class="container sf-in">
    <div>
      <p class="eyebrow">Unde ne găsiți</p>
      <p>{settings.address}</p>
    </div>
    <div>
      <p class="eyebrow">Contact</p>
      <p>{settings.phone}</p>
    </div>
    <div>
      <p class="eyebrow">Calendar</p>
      <p><a href="/program.ics">Abonare la program (.ics)</a></p>
    </div>
    <nav class="sf-nav" aria-label="Site">
      <p class="eyebrow">Site</p>
      <ul>
        {siteLinks.map((link) => (
          <li>
            <a
              href={link.href}
              aria-current={path === link.href ? 'page' : undefined}
            >{link.text}</a>
          </li>
        ))}
      </ul>
    </nav>
    <nav class="sf-nav" aria-label="Pagini">
      <p class="eyebrow">Pagini</p>
      <ul>
        {pages.map((page) => (
          <li>
            <a
              href={`/${page.data.path}/`}
              aria-current={path === `/${page.data.path}/` ? 'page' : undefined}
            >{page.data.title}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<style>
  .sf { border-top: 1px solid var(--rule); background: var(--raised); margin-top: 3rem; }
  .sf-in { display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1.5rem; padding-block: 2rem; }
  .sf p { margin: 0.35rem 0 0; font-size: 0.875rem; color: var(--muted); }
  /* Layout only: the link colours are global.css's `a`/`a:hover` pair, so the
     menu does not need its own hover rule to stay legible. Only the current
     page is coloured here, and its hover is written out beside it for the
     reason SiteHeader.astro documents at length - a scoped colour ships above
     the global (0,1,1) hover and silently freezes it. */
  .sf-nav ul { list-style: none; margin: 0.35rem 0 0; padding: 0; }
  .sf-nav li { margin: 0.15rem 0; }
  .sf-nav a { font-size: 0.875rem; }
  .sf-nav a[aria-current='page'] { color: var(--oxblood); }
  .sf-nav a[aria-current='page']:hover { color: var(--oxblood-dk); }
</style>
