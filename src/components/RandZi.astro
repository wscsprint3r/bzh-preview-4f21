---
/**
 * One day of the schedule: the date block on the left, the services on the
 * right, and whatever marks the day — feast, fast, cancellation, note.
 *
 * Rendered by /program/ and by the homepage's week band, so a change here
 * changes both. Every colour comes from a token in `global.css`; a hex literal
 * anywhere in this file fails `stylesheet.itest.ts` against `dist`.
 */
import type { ZiSlujba } from '../lib/schema';
import { numeLuna, numeZi, ziuaDinLuna } from '../lib/date-ro';
import { etichetaSlujba } from '../lib/schedule';

interface Props { zi: ZiSlujba }
const { zi } = Astro.props;
const praznic = Boolean(zi.praznic_mare || zi.praznic);
---

<div class:list={['rz', praznic && 'rz-praznic', zi.anulat && 'rz-anulat']}>
  <div class="rz-data">
    <span class="rz-zi">{numeZi(zi.data)}</span>
    <span class="rz-nr">{ziuaDinLuna(zi.data)}</span>
    <span class="rz-luna">{numeLuna(zi.data)}</span>
  </div>
  <div>
    {zi.anulat && <p class="rz-anulat-txt">Slujbele acestei zile sunt anulate.</p>}
    {/*
      Above the times, not below them, because it changes how the times should
      be read. `ics.ts` writes `z.locatie || opts.locatie` into LOCATION, so
      without this line a day moved to another chapel reached calendar
      subscribers and nobody else: the feed said one building, the page implied
      the usual one, and the reader of the page went to the wrong address.
      Phrased as a sentence about this day rather than as an address label, so
      it reads as the exception it is.

      Suppressed on a cancelled day, and that guard is the point rather than a
      detail. The two sentences were deliberately built to look like siblings,
      which is exactly what makes them read as compatible — "Slujbele acestei
      zile sunt anulate." followed by "Slujbele acestei zile au loc la
      Winterthur." is a flat contradiction. The line-through never reaches the
      accessibility tree, so a screen reader announces both with equal weight
      and nothing marks which one wins. A day that is not happening is not
      happening anywhere, so one condition suppresses the sentence rather than
      two sentences being reworded to stay consistent with each other.
    */}
    {!zi.anulat && zi.locatie && <p class="rz-loc">Slujbele acestei zile au loc la {zi.locatie}.</p>}
    {zi.slujbe.map((s) => (
      <div class="rz-slujba">
        <b>{s.ora}</b>
        <span>{etichetaSlujba(s)}</span>
      </div>
    ))}
    {zi.praznic && (
      <p class="rz-praznic-txt">
        {zi.praznic_mare && <span aria-hidden="true">† </span>}{zi.praznic}
        {/*
          The explicit space is load-bearing. JSX strips whitespace that spans a
          line break, so without it the two run together — `innerText` reads
          `Înălțarea Sfintei CruciZI DE POST`, which no screenshot and no axe run
          can see, but a screen reader says and a copy-paste keeps.
        */}
        {zi.zi_de_post && <>{' '}<span class="rz-post">Zi de post</span></>}
      </p>
    )}
    {!zi.praznic && zi.zi_de_post && <p class="rz-praznic-txt"><span class="rz-post">Zi de post</span></p>}
    {zi.note && <p class="rz-note">{zi.note}</p>}
  </div>
</div>

<style>
  /* `minmax(…, auto)` rather than a bare fixed track, on both sides of the
     breakpoint. The fixed value is only a MINIMUM now, so it decides how often
     rows line up with each other — it can no longer decide whether the day name
     fits. `auto` as the maximum is max-content, so a label wider than the
     minimum widens its own row instead of spilling across the gap into the
     times, and the worst case degrades from silent overlap to a visibly ragged
     column.

     Measured at 375px, where this matters most: the day names run
     Luni 34.0 · Vineri 49.1 · Sâmbătă 66.3 · Miercuri 69.5 · Duminică 72.6 px,
     against a 5rem (80px) minimum. Every Romanian day name clears it, so every
     row stays aligned. German does not — `Donnerstag` measures 94.2px — and the
     `de` locale the config already declares will push that one row wider rather
     than printing the day name over the service times. */
  .rz { display: grid; grid-template-columns: minmax(7rem, auto) 1fr; gap: 1.25rem; padding-block: 1rem; border-bottom: 1px solid var(--rule); }
  /* Feast days are marked by background AND a rule, never by colour alone.
     Flat, not a gradient: axe cannot determine contrast over a gradient and reports
     `incomplete`, which `npm run a11y` treats as a failure — so a gradient here would
     turn the feast row, the one row that matters most, into an unverifiable surface.
     The gradient's own contribution measured 1.06:1 against the page, so nothing is lost. */
  .rz-praznic { background: var(--raised); box-shadow: inset 0 2px 0 var(--gold-lt); }
  /* A cancelled day is marked by the sentence above and by a line through its
     times — deliberately NOT by dimming the row.

     `opacity` below 1 blends text toward the page, and this palette has no room
     for it. Measured with axe over this built page, with the row given
     `opacity: .75`: the service times fall from 4.67:1 to 2.96:1 and the day
     name from 4.69:1 to 2.95:1. Nor is there a value to tune it to —
     `--gold-text` drops below 4.5:1 at any opacity under 0.981 and `--faint`
     under 0.979, which is not a dimming, it is a rounding error.

     So the first time a volunteer ticks `anulat`, a dimmed row would fail
     `npm run a11y` and break the build — and it would do it on the one row a
     parishioner most needs to be able to read. A line-through also survives
     where opacity does not: it is not a colour, so it still reads at any
     contrast, and the sentence above carries the same fact to a screen reader,
     which sees nothing at all in an opacity change. */
  .rz-anulat .rz-slujba b, .rz-anulat .rz-slujba span { text-decoration: line-through; }
  .rz-zi { display: block; font-family: var(--display); font-size: 0.6875rem; letter-spacing: 0.2em; text-transform: uppercase; color: var(--faint); }
  .rz-nr { display: block; font-family: var(--display); font-size: 1.875rem; line-height: 1.05; color: var(--ink); }
  .rz-luna { display: block; font-size: 0.6875rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); }
  .rz-slujba { display: grid; grid-template-columns: 3.5rem 1fr; gap: 0.75rem; padding-block: 0.15rem; align-items: baseline; }
  .rz-slujba b { font-family: var(--display); font-size: 1.0625rem; font-weight: 600; color: var(--gold-text); }
  .rz-praznic-txt { font-family: var(--display); font-style: italic; font-size: 1.0625rem; color: var(--oxblood); margin: 0.5rem 0 0; }
  .rz-post { display: inline-block; font-family: var(--body); font-style: normal; font-size: 0.625rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--oxblood); border: 1px solid var(--rule); padding: 0.05rem 0.4rem; margin-left: 0.5rem; vertical-align: middle; }
  .rz-note, .rz-anulat-txt, .rz-loc { font-size: 0.875rem; color: var(--muted); margin: 0.4rem 0 0; }
  /* The two exception sentences introduce the times rather than follow them, so
     they need the space below as well; `.rz-note` trails the row and does not.
     `.rz-anulat-txt` is included because it sits in the identical position — the
     review named only `.rz-loc`, but fixing one of two identical cases leaves
     the other looking deliberate. */
  .rz-anulat-txt, .rz-loc { margin-bottom: 0.5rem; }
  @media (max-width: 34rem) {
    .rz { grid-template-columns: minmax(5rem, auto) 1fr; gap: 0.75rem; }
    .rz-luna { display: none; }
  }
</style>
