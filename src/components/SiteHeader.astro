---
const path = Astro.url.pathname;
/*
 * SEVEN LINKS, AND THE SET CHANGED ON 2026-09-21: `Evenimente` left the top
 * bar at the parish's request and `Școala parohială` took its place. Nothing
 * was orphaned by the swap - the event pages are still built and `Evenimente`
 * remains in the footer's `Site` menu, which is now its only inbound link on
 * every page, while `Școala parohială` is already in the footer's `Pagini`
 * menu through the `pages` collection. The rest of the list's history: the
 * five measured in Phase 1 plus `Contact` and `Donează`, settled by the parish
 * in Task 13, minus `Parohia` - removed from the top bar at the parish's
 * request (2026-09-19) and carried by the footer's `Pagini` menu, which
 * reaches `Istoric` and `Consiliul Parohial` on every page. This is the
 * primary navigation; the footer carries the rest of the sitemap - the eleven
 * prose pages plus a fixed `Site` list - and that is what makes every prose
 * page reachable from every visitor page.
 */
const links = [
  { href: '/', text: 'Acasă' },
  { href: '/program/', text: 'Program' },
  { href: '/noutati/', text: 'Noutăți' },
  { href: '/comunitate/scoala/', text: 'Școala parohială' },
  { href: '/servicii-liturgice/', text: 'Servicii liturgice' },
  { href: '/contact/', text: 'Contact' },
  { href: '/doneaza/', text: 'Donează' },
];
---

<header class="sh">
  <div class="container sh-in">
    <a class="sh-brand" href="/">
      <span class="sh-cross" aria-hidden="true">†</span>
      <span class="sh-wm">
        <b>Sfântul Nicolae</b>
        <span>Parohia Ortodoxă Română · Zürich</span>
      </span>
    </a>
    <nav aria-label="Navigare principală">
      <ul class="sh-nav">
        {links.map((l) => (
          <li>
            <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<style>
  .sh { border-bottom: 1px solid var(--rule); }
  .sh-in { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.75rem; flex-wrap: wrap; }
  .sh-brand { display: flex; align-items: center; gap: 0.625rem; text-decoration: none; }
  /* Ornament, not text: the dagger is aria-hidden and carries no information.
     U+2020, not U+271D — the Latin cross is in none of the self-hosted faces and
     fell back to an OS symbol font, while the dagger ships in our own latin-ext
     and is the conventional feast mark in Romanian Orthodox calendars. */
  .sh-cross { font-family: var(--display); color: var(--gold-lt); font-size: 1.75rem; line-height: 1; }
  .sh-wm b { display: block; font-family: var(--display); font-size: 1.125rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--oxblood); line-height: 1.1; }
  .sh-wm > span { display: block; font-size: 0.625rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--faint); margin-top: 0.15rem; }
  /*
   * WRAPS, and at 390px it has to: seven links are wider than the phone's
   * content column. The header row already wraps between brand and nav; this
   * is the nav's own wrap, so the links fold onto a second line instead of
   * overflowing the viewport. The row gap is smaller than the column gap so a
   * wrapped line reads as a continuation rather than as a second nav.
   */
  .sh-nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.25rem; list-style: none; margin: 0; padding: 0; font-size: 0.875rem; }
  /*
   * MEASURED AT 390px AFTER `Școala parohială` REPLACED `Evenimente`
   * (2026-09-21), in headless Chrome with the audits' own chromedriver and
   * `Emulation.setDeviceMetricsOverride`, because a window width under about
   * 500px is clamped silently. innerWidth 390, and a 15px scrollbar leaves the
   * document 375, so the phone's content column is 343px. The seven links
   * measure 37, 54, 48, 101, 103, 49 and 54px - 445px together - so the row
   * wraps to two lines whatever the gap: measured 4+3 at both this 12px gap
   * and the 20px desktop one, and two lines is the wrap Task 13 accepts. The
   * nav is 54px tall: two rows of about 23px plus the 8px row gap, where one
   * row would be about 23px. What this rule still decides is how tight the
   * wrapped row reads - 12px between links on a phone - not the one-line trick
   * it was written as when the header carried five. The numbers above replace
   * that claim rather than extending it. 34rem is not a new breakpoint: it is
   * the one `DayRow` and `WeekBand` already cut at, so the audit's derived
   * breakpoint set is unchanged.
   */
  @media (max-width: 34rem) {
    .sh-nav { gap: 0.5rem 0.75rem; }
  }
  .sh-nav a { color: var(--muted); text-decoration: none; }
  .sh-nav a[aria-current='page'] { color: var(--oxblood); border-bottom: 1.5px solid var(--gold-lt); padding-bottom: 2px; }
  /* A component that colours a link owns that link's hover, and both rules above
     do. This is the third site of the same trap — after `.subscribe a` on
     `/program/` — and the worst placed, because the header is on every page.
     Astro adds a `data-astro-cid-…` attribute to each compound, so
     `.sh-nav a` ships at (0,3,1) and the `[aria-current]` rule at (0,4,1),
     against global.css's `a:hover` at (0,1,1). Both won, silently: measured in a
     real browser before the fix, the computed colour did not change on hover for
     either link.

     BOTH selectors are listed on purpose rather than relying on source order.
     `.sh-nav a:hover` is (0,4,1) — a tie with the `[aria-current]` rule, which a
     later reordering of this block would flip. `.sh-nav a[aria-current='page']:hover`
     is (0,5,1) and wins outright, whatever the order.

     Focus needs no rule here: `outline` is declared nowhere in this project but
     global.css, so `:focus-visible` has nothing to beat. Verified on the built
     page — the ring computes to `rgb(107,31,38) solid 2px`, i.e. `--oxblood`. */
  .sh-nav a:hover,
  .sh-nav a[aria-current='page']:hover { color: var(--oxblood-dk); }
</style>
